# URL publique du backend Express (server/). En local : http://localhost:4000
# En production sur Vercel, pointez vers votre déploiement Render/Railway, ex:
# https://fifa26-control-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:4000

# URL publique du site (utilisée pour les métadonnées Open Graph, robots.txt, sitemap.xml)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Authentification "espace supporter" (better-auth + PostgreSQL) ---
# Chaîne de connexion PostgreSQL (ex: Neon, Supabase, Vercel Postgres)
DATABASE_URL=postgres://user:password@host:5432/database

# URL de base utilisée par better-auth pour générer les liens/cookies
BETTER_AUTH_URL=http://localhost:3000

# Secret utilisé par better-auth pour signer sessions/cookies — obligatoire.
# Générez-en un avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=change-moi-avec-une-valeur-aleatoire-longue
